+#if CONFIG_MAIXPY_CATALYST_COPROCESSOR
+// Catalyst Coprocessor (port/src/catalyst/modcatalyst.c): time from the
+// CLINT's timer, continuous across changes of the CPU clock and while the
+// CPU waits for an interrupt; and delays that sleep.
+extern uint64_t catalyst_time_us(void);
+extern volatile int catalyst_sleeping;
+
+mp_uint_t mp_hal_ticks_us(void)
+{
+	return (mp_uint_t)catalyst_time_us();
+}
+
+mp_uint_t mp_hal_ticks_ms(void)
+{
+	return (mp_uint_t)(catalyst_time_us() / 1000);
+}
+#else
 mp_uint_t inline mp_hal_ticks_us(void)
 {
 	return (unsigned long)(read_csr(mcycle)/(sysctl_clock_get_freq(SYSCTL_CLOCK_CPU)/1000000));
