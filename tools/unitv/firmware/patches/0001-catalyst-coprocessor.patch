 			mp_uint_t dt;
 			mp_uint_t t0 = mp_hal_ticks_us();
+#if CONFIG_MAIXPY_CATALYST_COPROCESSOR
+			// Asleep a tick at a time (the idle task waits for an interrupt
+			// meanwhile: the tick, or a byte on a UART), at least `ms` and at
+			// most a tick (10 ms) more; under 2 ms, MaixPy's exact busy wait.
+			if (catalyst_sleeping && ms >= 2) {
+				const mp_uint_t tick = portTICK_PERIOD_MS * 1000;
+				for (;;) {
+					extern void mp_handle_pending();
+					mp_handle_pending();
+					dt = mp_hal_ticks_us() - t0;
+					if (dt >= us) {
+						return;
+					}
+					MP_THREAD_GIL_EXIT();
+					vTaskDelay((TickType_t)((us - dt + tick - 1) / tick));
+					MP_THREAD_GIL_ENTER();
+				}
+			}
+#endif
 			for (;;) {
 				extern void mp_handle_pending();
 				mp_handle_pending();
