image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		}
	}

	size = 64M
}

image data.ext4 {
	ext4 {
		label = "data"
	}

	empty = true
	size = 64M
}

image sdcard.img {
	# Partitions start on 1 MiB boundaries, which SD cards are laid out for.
	hdimage {
		align = "1M"
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
