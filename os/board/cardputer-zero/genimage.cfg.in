# The card, laid out for A/B updates:
#
#   1  boot      FAT   the firmware, config.txt, and each system's kernel in
#                      its own folder (slot-a/, slot-b/)
#   2  system-a  ext4  one system (read-only when running)
#   3  system-b  ext4  the other: an update is written here while A runs,
#                      tried once, and kept only if it comes up
#   4  data      ext4  everything that must survive: grows to fill the card

image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		}
	}

	size = 128M
}

image data.ext4 {
	ext4 {
		label = "data"
		# Laid out for the card it grows into, not for its 64 MB start: 4 KB
		# blocks and one inode per 64 KB (a small filesystem would get 1 KB
		# blocks and one per 4 KB, which on a 128 GB card is ~8 GB of inode
		# tables), and room in its tables to grow online to 256 GB.
		extraargs = "-b 4096 -i 65536 -E resize=67108864"
	}

	empty = true
	size = 64M
}

image sdcard.img {
	# Partitions start on 1 MiB boundaries, which SD cards are laid out for.
	hdimage {
		align = "1M"
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition system-a {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	# Empty until the first update is written into it.
	partition system-b {
		partition-type = 0x83
		size = 1024M
	}

	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
