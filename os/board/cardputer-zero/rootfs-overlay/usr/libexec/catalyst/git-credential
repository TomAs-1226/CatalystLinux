#!/bin/sh
# git's credential helper on the handheld, named in /etc/gitconfig for
# https://github.com: the GitHub key from Settings › Keys, with the login it
# belongs to (Git › Account). It answers `get` for https://github.com and
# nothing else: store and erase are ignored (Settings keeps the key), and any
# other server gets no answer at all.
#
# (The files can be moved for a test: CATALYST_KEYS, CATALYST_GITHUB.)
[ "${1:-}" = get ] || exit 0
KEYS="${CATALYST_KEYS:-/data/catalyst/keys}"
ACCOUNT="${CATALYST_GITHUB:-/data/catalyst/github}"
protocol=""
host=""
while IFS= read -r line; do
	[ -n "$line" ] || break
	case "$line" in
	protocol=*) protocol="${line#protocol=}" ;;
	host=*) host="${line#host=}" ;;
	esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
token=$(sed -n 's/^github=//p' "$KEYS" 2>/dev/null | head -n 1)
[ -n "$token" ] || exit 0
login=$(sed -n 's/^login=//p' "$ACCOUNT" 2>/dev/null | head -n 1)
printf 'username=%s\npassword=%s\n' "${login:-x-access-token}" "$token"
