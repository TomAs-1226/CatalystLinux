#!/bin/sh
# catalyst-power: the parts of power saving (and the panel) that need the
# system's hands.
#
#   catalyst-power wifi-sleep     Wi-Fi off while the screen is off (the
#                                 choice to have Wi-Fi is kept)
#   catalyst-power wifi-wake      and back, if it is switched on
#   catalyst-power undervolt on|off|status|confirm
#   catalyst-power panel try|on|off|status|confirm|revert
#   catalyst-power boot           at start: a trial that never held is undone
#
# Both trials are lines in config.txt, above the system block, tried before
# they are kept: the first start with them counts, and the shell confirms
# them (lower voltage once it has run on it for five minutes; the tear-free
# panel once Enter answers its question). A start that finds one tried but
# never confirmed (that start crashed, hung, was cut off, or nobody could see
# to answer) takes it out again and restarts.
#
# Lower voltage: the processor's core a step lower than the firmware's own
# (over_voltage -1, -25 mV at full speed; over_voltage_min -2, -50 mV when
# idle, where there is the most to spare).
#
# Tear-free panel: the cardputerzero-portrait overlay after M5Stack's, which
# drives the panel in its own scan order and in step with its refresh.

BOOT_DEV=/dev/mmcblk0p1
MNT=/run/catalyst-boot
END="# catalyst-power: end"
SLOTS="# Which system starts:"

# Each trial: its marker line, its lines in config.txt, and its state file.
begin_of() {
	case "$1" in
	undervolt) echo "# catalyst-power: lower voltage (Settings > Developer options)" ;;
	panel) echo "# catalyst-power: tear-free panel (Settings > Developer options)" ;;
	esac
}

lines_of() {
	case "$1" in
	undervolt) printf 'over_voltage=-1\nover_voltage_min=-2\n' ;;
	panel) printf 'dtoverlay=cardputerzero-portrait\n' ;;
	esac
}

state_file() {
	echo "/data/catalyst/$1"
}

state() {
	cat "$(state_file "$1")" 2>/dev/null || echo off
}

set_state() {
	mkdir -p /data/catalyst
	echo "$2" >"$(state_file "$1")"
	sync
}

# Run "$@" with the boot partition mounted read-write at $MNT.
with_boot() {
	mkdir -p "$MNT"
	mount -t vfat -o rw "$BOOT_DEV" "$MNT" || return 1
	"$@"
	status=$?
	sync
	umount "$MNT"
	return $status
}

# config.txt without a trial's block (and the blank line put after it), the
# marker matched as plain text.
strip_block() {
	begin=$(begin_of "$1")
	awk -v begin="$begin" -v end="$END" '
		skip == 1 { if ($0 == end) skip = 2; next }
		skip == 2 { skip = 0; if ($0 == "") next }
		$0 == begin { skip = 1; next }
		{ print }
	' "$MNT/config.txt" >"$MNT/config.new" && mv "$MNT/config.new" "$MNT/config.txt"
}

# config.txt with a trial's block just before the system block (so after the
# board's own lines: an overlay there comes after the one it builds on).
add_block() {
	strip_block "$1" || return 1
	block=$(
		begin_of "$1"
		lines_of "$1"
		echo "$END"
	)
	awk -v block="$block" -v slots="$SLOTS" '
		!done && index($0, slots) == 1 { print block; print ""; done = 1 }
		{ print }
		END { if (!done) print block }
	' "$MNT/config.txt" >"$MNT/config.new" && mv "$MNT/config.new" "$MNT/config.txt"
}

# undervolt|panel on|off|confirm|status
trial() {
	name=$1
	case "$2" in
	on)
		with_boot add_block "$name" || exit 1
		# trying 0: set, not yet started with.
		set_state "$name" "trying 0"
		;;
	off)
		with_boot strip_block "$name" || exit 1
		rm -f "$(state_file "$name")"
		sync
		;;
	confirm)
		[ "$(state "$name")" = "trying 1" ] && set_state "$name" on
		;;
	status)
		case "$(state "$name")" in
		trying*) echo trying ;;
		*) state "$name" ;;
		esac
		;;
	*)
		echo "usage: $0 $name on|off|status|confirm" >&2
		exit 2
		;;
	esac
}

# At start: a trial set is now being tried; one tried and never confirmed is
# taken out again, and the machine restarts without it.
boot_trial() {
	name=$1
	case "$(state "$name")" in
	"trying 0")
		set_state "$name" "trying 1"
		;;
	"trying 1")
		if with_boot strip_block "$name"; then
			set_state "$name" failed
			echo "catalyst-power: $name did not hold; restarting without it" >&2
			umount /data 2>/dev/null
			busybox reboot -f
		fi
		;;
	esac
}

case "$1" in
wifi-sleep)
	rc-service catalyst-wifi stop >/dev/null 2>&1
	;;
wifi-wake)
	[ -e /data/catalyst/wifi-enabled ] && rc-service catalyst-wifi start >/dev/null 2>&1
	exit 0
	;;
undervolt)
	trial undervolt "$2"
	;;
panel)
	case "$2" in
	# Set it and restart into it at once: the start it is tried in asks.
	try)
		trial panel on
		reboot
		;;
	# Not kept (no answer, or Esc): out again, and back to the panel as it was.
	revert)
		with_boot strip_block panel
		set_state panel failed
		reboot
		;;
	*)
		trial panel "$2"
		;;
	esac
	;;
boot)
	boot_trial undervolt
	boot_trial panel
	;;
*)
	echo "usage: $0 wifi-sleep|wifi-wake|undervolt ...|panel ...|boot" >&2
	exit 2
	;;
esac
