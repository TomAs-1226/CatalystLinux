#!/bin/sh
# catalyst-power: the parts of power saving (and the panel) that need the
# system's hands.
#
#   catalyst-power wifi-sleep     Wi-Fi off while the screen is off (the
#                                 choice to have Wi-Fi is kept)
#   catalyst-power wifi-wake      and back, if it is switched on
#   catalyst-power undervolt try|on|off|status|confirm
#   catalyst-power panel try|on|off|status|confirm|revert
#   catalyst-power deep on [keep-wifi] [keep-radios]|off|status
#                                 deep standby: everything a key need not
#                                 have off, and back (see deep_on); music
#                                 standby keeps the radios (and Wi-Fi)
#   catalyst-power boot           at start: a trial that never held is undone
#
# Both trials are lines in config.txt, above the system block, tried before
# they are kept: the first start with them counts, and the shell confirms
# them (lower voltage once it has run on it for five minutes; the tear-free
# panel once Enter answers its question). A start that finds one tried but
# never confirmed (that start crashed, hung, was cut off, or nobody could see
# to answer) takes it out again and restarts. `try` sets one and restarts
# into it at once.
#
# Lower voltage: the processor's core a step lower than the firmware's own
# (over_voltage -1, -25 mV at full speed; over_voltage_min -2, -50 mV when
# idle, where there is the most to spare). While it is being tried the
# hardware watchdog is fed, so a processor that hangs on it is restarted
# within 15 seconds, and that start takes it out again; once kept, the
# watchdog is stood down.
#
# Tear-free panel: the cardputerzero-portrait overlay after M5Stack's, which
# drives the panel in its own scan order and in step with its refresh.

BOOT_DEV=/dev/mmcblk0p1
MNT=/run/catalyst-boot
END="# catalyst-power: end"
SLOTS="# Which system starts:"
WATCHDOG_DEV=/dev/watchdog
WATCHDOG_PID=/run/catalyst-power-watchdog.pid
# Set by the firmware (4 bytes, big-endian 1) when this start is an update
# being tried ("0 tryboot"): catalyst-update feeds the watchdog then.
TRYBOOT=/proc/device-tree/chosen/bootloader/tryboot
# Where deep standby finds the hardware, and keeps what it switched off.
SYS=/sys
RUN=/run

# Each trial: its marker line, its lines in config.txt, and its state file.
begin_of() {
	case "$1" in
	undervolt) echo "# catalyst-power: lower voltage (Settings > Developer options)" ;;
	panel) echo "# catalyst-power: tear-free panel (Settings > Developer options)" ;;
	esac
}

lines_of() {
	case "$1" in
	undervolt) printf 'over_voltage=-1\nover_voltage_min=-2\n' ;;
	panel) printf 'dtoverlay=cardputerzero-portrait\n' ;;
	esac
}

state_file() {
	echo "/data/catalyst/$1"
}

state() {
	cat "$(state_file "$1")" 2>/dev/null || echo off
}

set_state() {
	mkdir -p /data/catalyst
	echo "$2" >"$(state_file "$1")"
	sync
}

# Run "$@" with the boot partition mounted read-write at $MNT.
with_boot() {
	mkdir -p "$MNT"
	mount -t vfat -o rw "$BOOT_DEV" "$MNT" || return 1
	"$@"
	status=$?
	sync
	umount "$MNT"
	return $status
}

# config.txt without a trial's block (and the blank line put after it), the
# marker matched as plain text.
strip_block() {
	begin=$(begin_of "$1")
	awk -v begin="$begin" -v end="$END" '
		skip == 1 { if ($0 == end) skip = 2; next }
		skip == 2 { skip = 0; if ($0 == "") next }
		$0 == begin { skip = 1; next }
		{ print }
	' "$MNT/config.txt" >"$MNT/config.new" && mv "$MNT/config.new" "$MNT/config.txt"
}

# config.txt with a trial's block just before the system block (so after the
# board's own lines: an overlay there comes after the one it builds on).
add_block() {
	strip_block "$1" || return 1
	block=$(
		begin_of "$1"
		lines_of "$1"
		echo "$END"
	)
	awk -v block="$block" -v slots="$SLOTS" '
		!done && index($0, slots) == 1 { print block; print ""; done = 1 }
		{ print }
		END { if (!done) print block }
	' "$MNT/config.txt" >"$MNT/config.new" && mv "$MNT/config.new" "$MNT/config.txt"
}

# The hardware watchdog fed while a lower voltage is tried (BusyBox's
# watchdog: a 15 s timeout, the most the BCM2835's allows, fed every 5 s).
# Stopping it writes the magic close, so it stands down rather than firing.
# Not on a start that is an update being tried: catalyst-update holds the
# watchdog then (only one can), and a hang there goes back to the system
# before, whose next start takes the lower voltage out as well.
watch_trial() {
	[ -e "$WATCHDOG_DEV" ] || return 0
	if [ "$(wc -c <"$TRYBOOT" 2>/dev/null)" = 4 ] && [ "$(tail -c 1 "$TRYBOOT")" = "$(printf '\001')" ]; then
		return 0
	fi
	stop_watch
	watchdog -F -T 15 -t 5 "$WATCHDOG_DEV" >/dev/null 2>&1 &
	echo $! >"$WATCHDOG_PID"
}

stop_watch() {
	if [ -s "$WATCHDOG_PID" ]; then
		kill "$(cat "$WATCHDOG_PID")" 2>/dev/null
	fi
	rm -f "$WATCHDOG_PID"
}

# undervolt|panel on|off|confirm|status
trial() {
	name=$1
	case "$2" in
	on)
		with_boot add_block "$name" || exit 1
		# trying 0: set, not yet started with.
		set_state "$name" "trying 0"
		;;
	off)
		with_boot strip_block "$name" || exit 1
		rm -f "$(state_file "$name")"
		sync
		if [ "$name" = undervolt ]; then
			stop_watch
		fi
		;;
	confirm)
		if [ "$(state "$name")" = "trying 1" ]; then
			set_state "$name" on
			if [ "$name" = undervolt ]; then
				stop_watch
			fi
		fi
		;;
	status)
		case "$(state "$name")" in
		trying*) echo trying ;;
		*) state "$name" ;;
		esac
		;;
	*)
		echo "usage: $0 $name try|on|off|status|confirm" >&2
		exit 2
		;;
	esac
}

# At start: a trial set is now being tried; one tried and never confirmed is
# taken out again, and the machine restarts without it.
boot_trial() {
	name=$1
	case "$(state "$name")" in
	"trying 0")
		set_state "$name" "trying 1"
		if [ "$name" = undervolt ]; then
			watch_trial
		fi
		;;
	"trying 1")
		if with_boot strip_block "$name"; then
			set_state "$name" failed
			echo "catalyst-power: $name did not hold; restarting without it" >&2
			umount /data 2>/dev/null
			busybox reboot -f
		fi
		;;
	esac
}

# Deep standby: as near off as the handheld can be while a key can still wake
# it. The CM0 has no suspend, and only the slide switch cuts the power, so
# this is everything the keyboard does not need, switched off. The shell has
# already put out the screen and the keyboard's lights, slowed the processor
# to its least and paused its own polling; this does the rest, in this order:
#
#   1. Wi-Fi off, its driver unloaded (if it was running);
#   2. any other radio blocked (Bluetooth too, while it is on);
#   3. the USB host stopped: the dwc2 controller unbound, so the hub and the
#      Ethernet chip on it go quiet. Not while the handheld is a computer's
#      device (USB mode serial, network or drive);
#   4. the Grove and HAT 5 V outputs off;
#   5. the red light dark.
#
# Music standby (music playing with the screen off) is the same with
# `keep-radios` (Bluetooth headphones may be what plays) and, while what
# plays next comes over the network, `keep-wifi`. The sound itself is never
# touched: I2S, the codec and the amplifier belong to whatever plays.
#
# What each step switched off is noted in $DEEP, and `deep off` brings back
# just that, in the reverse order. `deep on` again takes only the steps not
# yet taken (the music stopped: Wi-Fi and the radios go too), noted after the
# others, so they come back first. Wi-Fi comes back in the background: it
# takes a few seconds, and nothing waits for it.
DEEP=$RUN/catalyst-deep

# A step this deep standby has already taken (by its kind: wifi, radio...).
noted() {
	grep -q "^$1\( \|$\)" "$DEEP" 2>/dev/null
}

deep_on() {
	keep_wifi=no
	keep_radios=no
	for keep in "$@"; do
		case "$keep" in
		keep-wifi) keep_wifi=yes ;;
		keep-radios) keep_radios=yes ;;
		*)
			echo "catalyst-power deep on: keep-wifi or keep-radios, not $keep" >&2
			return 2
			;;
		esac
	done
	mkdir -p "$RUN"
	cp "$DEEP" "$DEEP.new" 2>/dev/null || : >"$DEEP.new"
	if [ $keep_wifi = no ] && ! noted wifi; then
		case "$(cat "$RUN/catalyst-wifi.status" 2>/dev/null)" in
		running | starting)
			rc-service catalyst-wifi stop >/dev/null 2>&1
			echo wifi >>"$DEEP.new"
			;;
		esac
	fi
	if [ $keep_radios = no ] && ! noted radio; then
		for r in "$SYS"/class/rfkill/rfkill*; do
			[ -e "$r/soft" ] || continue
			if [ "$(cat "$r/soft")" = 0 ] && echo 1 >"$r/soft"; then
				echo "radio ${r##*/}" >>"$DEEP.new"
			fi
		done
	fi
	peripheral=no
	for m in "$SYS"/firmware/devicetree/base/soc/usb@*/dr_mode; do
		[ -e "$m" ] || continue
		[ "$(tr -d '\000' <"$m")" = peripheral ] && peripheral=yes
	done
	if [ $peripheral = no ] && ! noted usb; then
		for d in "$SYS"/bus/platform/drivers/dwc2/*.usb; do
			[ -e "$d" ] || continue
			name=${d##*/}
			# A computer has it as its device: left be.
			[ "$(cat "$SYS/class/udc/$name/state" 2>/dev/null)" = configured ] && continue
			if echo "$name" >"$SYS/bus/platform/drivers/dwc2/unbind"; then
				echo "usb $name" >>"$DEEP.new"
			fi
		done
	fi
	if ! noted out; then
		for led in grove_5v_out ext_5v_out; do
			b=$SYS/class/leds/$led/brightness
			[ -e "$b" ] || continue
			level=$(cat "$b")
			if [ "$level" != 0 ] && echo 0 >"$b"; then
				echo "out $led $level" >>"$DEEP.new"
			fi
		done
	fi
	if ! noted red; then
		for led in ACT led0; do
			d=$SYS/class/leds/$led
			[ -e "$d/trigger" ] || continue
			trigger=$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' "$d/trigger")
			echo "red $led ${trigger:-none} $(cat "$d/brightness")" >>"$DEEP.new"
			# Brightness 0 first: it lets go of any trigger (a card access
			# could light it between the two writes otherwise).
			echo 0 >"$d/brightness"
			echo none >"$d/trigger"
			break
		done
	fi
	mv "$DEEP.new" "$DEEP"
}

deep_off() {
	[ -e "$DEEP" ] || return 0
	# The noted steps, last first.
	awk '{ line[NR] = $0 } END { for (i = NR; i > 0; i--) print line[i] }' "$DEEP" | while read -r what name value extra; do
		case "$what" in
		red)
			d=$SYS/class/leds/$name
			echo "$value" >"$d/trigger"
			[ "$value" = none ] && echo "$extra" >"$d/brightness"
			;;
		out) echo "$value" >"$SYS/class/leds/$name/brightness" ;;
		usb) echo "$name" >"$SYS/bus/platform/drivers/dwc2/bind" ;;
		radio) [ -e "$SYS/class/rfkill/$name/soft" ] && echo 0 >"$SYS/class/rfkill/$name/soft" ;;
		wifi)
			if [ -e /data/catalyst/wifi-enabled ]; then
				(rc-service catalyst-wifi start >/dev/null 2>&1 &)
			fi
			;;
		esac
	done
	rm -f "$DEEP"
}

case "$1" in
deep)
	case "$2" in
	on)
		shift 2
		deep_on "$@" || exit 2
		;;
	off) deep_off ;;
	status) if [ -e "$DEEP" ]; then echo on; else echo off; fi ;;
	*)
		echo "usage: $0 deep on [keep-wifi] [keep-radios]|off|status" >&2
		exit 2
		;;
	esac
	;;
wifi-sleep)
	rc-service catalyst-wifi stop >/dev/null 2>&1
	;;
wifi-wake)
	[ -e /data/catalyst/wifi-enabled ] && rc-service catalyst-wifi start >/dev/null 2>&1
	exit 0
	;;
undervolt)
	case "$2" in
	# Set it and restart into it at once: that start tries it.
	try)
		trial undervolt on
		reboot
		;;
	*)
		trial undervolt "$2"
		;;
	esac
	;;
panel)
	case "$2" in
	# Set it and restart into it at once: the start it is tried in asks.
	try)
		trial panel on
		reboot
		;;
	# Not kept (no answer, or Esc): out again, and back to the panel as it was.
	revert)
		with_boot strip_block panel
		set_state panel failed
		reboot
		;;
	*)
		trial panel "$2"
		;;
	esac
	;;
boot)
	boot_trial undervolt
	boot_trial panel
	;;
*)
	echo "usage: $0 wifi-sleep|wifi-wake|undervolt ...|panel ...|deep ...|boot" >&2
	exit 2
	;;
esac
