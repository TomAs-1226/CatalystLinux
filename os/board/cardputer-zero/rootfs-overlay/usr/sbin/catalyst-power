#!/bin/sh
# catalyst-power: the parts of power saving that need the system's hands.
#
#   catalyst-power wifi-sleep     Wi-Fi off while the screen is off (the
#                                 choice to have Wi-Fi is kept)
#   catalyst-power wifi-wake      and back, if it is switched on
#   catalyst-power undervolt on|off|status|confirm
#   catalyst-power boot           at start: an undervolt that never held is undone
#
# Lower voltage: the processor's core a step lower than the firmware's own
# (over_voltage -1, -25 mV at full speed; over_voltage_min -2, -50 mV when
# idle, where there is the most to spare). It is tried before it is kept: the
# first start with it counts, and once the shell has run on it for five
# minutes it is confirmed. A start that finds it tried but never confirmed
# (that start crashed, hung or was cut off) takes it out again and restarts.

STATE=/data/catalyst/undervolt
BOOT_DEV=/dev/mmcblk0p1
MNT=/run/catalyst-boot
BEGIN="# catalyst-power: lower voltage (Settings > Developer options)"
END="# catalyst-power: end"
SLOTS="# Which system starts:"

# Run "$@" with the boot partition mounted read-write at $MNT.
with_boot() {
	mkdir -p "$MNT"
	mount -t vfat -o rw "$BOOT_DEV" "$MNT" || return 1
	"$@"
	status=$?
	sync
	umount "$MNT"
	return $status
}

# config.txt without the block, then with it before the system block.
strip_block() {
	sed "/^$BEGIN\$/,/^$END\$/d" "$MNT/config.txt" >"$MNT/config.new" &&
		mv "$MNT/config.new" "$MNT/config.txt"
}

add_block() {
	strip_block || return 1
	awk -v begin="$BEGIN" -v end="$END" -v slots="$SLOTS" '
		!done && index($0, slots) == 1 {
			print begin; print "over_voltage=-1"; print "over_voltage_min=-2"; print end; print ""
			done = 1
		}
		{ print }
		END { if (!done) { print begin; print "over_voltage=-1"; print "over_voltage_min=-2"; print end } }
	' "$MNT/config.txt" >"$MNT/config.new" && mv "$MNT/config.new" "$MNT/config.txt"
}

state() {
	cat "$STATE" 2>/dev/null || echo off
}

case "$1" in
wifi-sleep)
	rc-service catalyst-wifi stop >/dev/null 2>&1
	;;
wifi-wake)
	[ -e /data/catalyst/wifi-enabled ] && rc-service catalyst-wifi start >/dev/null 2>&1
	exit 0
	;;
undervolt)
	case "$2" in
	on)
		with_boot add_block || exit 1
		mkdir -p /data/catalyst
		# trying 0: set, not yet started with.
		echo "trying 0" >"$STATE"
		sync
		;;
	off)
		with_boot strip_block || exit 1
		rm -f "$STATE"
		sync
		;;
	confirm)
		case "$(state)" in
		"trying 1") echo on >"$STATE" && sync ;;
		esac
		;;
	status)
		case "$(state)" in
		trying*) echo trying ;;
		*) state ;;
		esac
		;;
	*)
		echo "usage: $0 undervolt on|off|status|confirm" >&2
		exit 2
		;;
	esac
	;;
boot)
	case "$(state)" in
	"trying 0")
		echo "trying 1" >"$STATE"
		sync
		;;
	"trying 1")
		# The last start ran with it and never confirmed: take it out.
		if with_boot strip_block; then
			echo failed >"$STATE"
			sync
			echo "catalyst-power: lower voltage did not hold; restarting without it" >&2
			umount /data 2>/dev/null
			busybox reboot -f
		fi
		;;
	esac
	;;
*)
	echo "usage: $0 wifi-sleep|wifi-wake|undervolt ...|boot" >&2
	exit 2
	;;
esac
