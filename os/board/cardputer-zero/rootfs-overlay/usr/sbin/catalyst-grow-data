#!/bin/sh
# Grow the data partition to fill the SD card, once.
#
# The image carries a small /data so it flashes quickly; logs want the whole
# card. Growing takes two boots: the first rewrites partition 3 to run to the
# end of the card and restarts (the kernel cannot re-read the table of the
# disk it is running from); the second enlarges the filesystem to match.
#
#   catalyst-grow-data [disk] [partition device]     defaults: the SD card
#   catalyst-grow-data --table-only <disk or image>  only rewrite the table

DISK="${1:-/dev/mmcblk0}"
PART="${2:-/dev/mmcblk0p3}"
DONE=/data/.grown
PENDING=/data/.grow-pending

# Recreate partition 3 from its present start to the end of the disk.
# $1: disk, $2: first sector of partition 3
rewrite_table() {
	# -u: sectors. BusyBox fdisk otherwise works in cylinders and would move the start.
	printf 'd\n3\nn\np\n3\n%s\n\nw\n' "$2" | fdisk -u "$1" >/dev/null 2>&1
}

if [ "$1" = "--table-only" ]; then
	start=$(fdisk -l "$2" | awk '$1 ~ /3$/ { print $(NF-5) }' | tail -1)
	[ -n "$start" ] || exit 1
	rewrite_table "$2" "$start"
	exit 0
fi

[ -e "$DONE" ] && exit 0
[ -w /data ] || exit 0

name=$(basename "$DISK")
pname=$(basename "$PART")
start=$(cat "/sys/block/$name/$pname/start" 2>/dev/null) || exit 0
size=$(cat "/sys/block/$name/$pname/size")
total=$(cat "/sys/block/$name/size")

# More than 8 MB of card past the partition, and not tried yet: rewrite, restart.
if [ $((start + size + 16384)) -lt "$total" ] && [ ! -e "$PENDING" ]; then
	touch "$PENDING"
	sync
	rewrite_table "$DISK" "$start"
	sync
	reboot
	exit 0
fi

# Second boot (or nothing to gain): bring the filesystem up to the partition.
resize2fs "$PART" >/dev/null 2>&1
rm -f "$PENDING"
touch "$DONE"
