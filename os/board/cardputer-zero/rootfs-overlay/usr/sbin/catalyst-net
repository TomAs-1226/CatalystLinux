#!/bin/sh
# What to do when a network link comes up or goes down. Run by ifplugd, which
# the kernel tells about the cable (or the Wi-Fi joining a network):
#
#   catalyst-net <interface> up|down [dhcp-only]
#
# Up: DHCP first (a robot radio, a router). With no DHCP server, as on a cable
# straight into the Systemcore, take a fixed address on the team's robot
# network (10.TE.AM.77) so the robot at 10.TE.AM.2 is reachable. "dhcp-only"
# never falls back (Wi-Fi joins whatever network it is told to).

ROBOT_FILE=/data/catalyst/robot

# The address to fall back to, from the robot the user set: a team number or
# a 10.TE.AM.x address. A hostname gives no subnet to guess, so nothing.
robot_static() {
	r=$(cat "$ROBOT_FILE" 2>/dev/null)
	case "$r" in
	'' | *[!0-9.]*) return ;;
	10.*.*.*) echo "$r" | awk -F. '{ print "10." $2 "." $3 ".77" }' ;;
	*.*) return ;;
	*) [ "${#r}" -le 5 ] && echo "10.$((r / 100)).$((r % 100)).77" ;;
	esac
}

# For testing the address rule on its own.
if [ "${1:-}" = "--static-for" ]; then
	ROBOT_FILE="$2"
	robot_static
	exit 0
fi

IF="$1"
PIDFILE="/run/udhcpc.$IF.pid"

stop_dhcp() {
	[ -e "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
	rm -f "$PIDFILE"
}

case "${2:-}" in
up)
	stop_dhcp
	# Four quick tries, then keep asking in the background. The handheld's
	# name goes with the request, so a router lists it by that name.
	udhcpc -i "$IF" -b -t 4 -T 1 -p "$PIDFILE" -x "hostname:$(hostname)" >/dev/null 2>&1
	if [ "${3:-}" != dhcp-only ] && ! ip -4 addr show dev "$IF" | grep -q 'inet '; then
		addr=$(robot_static)
		[ -n "$addr" ] && ip addr replace "$addr/24" dev "$IF"
	fi
	;;
down)
	stop_dhcp
	ip addr flush dev "$IF" 2>/dev/null
	;;
*)
	echo "usage: $0 <interface> up|down [dhcp-only]" >&2
	exit 2
	;;
esac
exit 0
