#!/sbin/openrc-run
# Everything that can wait until the screen is on: the name, the rest of the
# board's drivers, hotplug, and the system log.

description="The rest of the system, behind the shell"

depend() {
	need catalyst-early
	after catalyst-shell
}

start() {
	ebegin "Bringing up the rest of the system"
	# The name chosen in setup or Settings (kept on /data), else the image's own.
	if [ -s /data/catalyst/hostname ]; then
		hostname -F /data/catalyst/hostname
	else
		hostname -F /etc/hostname
	fi
	ip link set lo up

	# The system log, kept as a 64 KB ring in memory: read it with `logread`.
	# (The kernel's own log is `dmesg`.)
	syslogd -C64

	# Battery gauge and power-fail watcher.
	# shellcheck disable=SC2046
	modprobe -a $(grep -v '^#' /etc/modules-load.d/cardputer-zero.late) 2>/dev/null

	# Hotplug: load a driver when its device appears (a USB adapter, a drive),
	# and now for whatever is already there.
	start-stop-daemon -S -b -x /sbin/mdev -- -df
	find /sys/devices -name modalias -print0 2>/dev/null | xargs -0 sort -u | tr '\n' '\0' | xargs -0 modprobe -abq 2>/dev/null

	# Looking through /sys above left the kernel remembering thousands of file
	# names it will not need again; hand that memory back.
	echo 2 >/proc/sys/vm/drop_caches

	# No compacting memory ahead of need: kcompactd otherwise wakes twice a
	# second to see whether it should, for huge pages this kernel does not
	# have. Memory is still compacted when an allocation asks for it.
	echo 0 >/proc/sys/vm/compaction_proactiveness 2>/dev/null

	# Writes go to the card a little at a time: from 4 MB held back, and never
	# more than 16 MB. The default (a fifth of memory, about 85 MB) let a song
	# being saved or an update installing build up, then write all at once
	# while everything else waited on the card: the screen stuttered.
	echo 4194304 >/proc/sys/vm/dirty_background_bytes
	echo 16777216 >/proc/sys/vm/dirty_bytes
	# BFQ for the card: it honours I/O priorities (mq-deadline, the default,
	# ignores them), so downloads, updates and indexing, all at the idle
	# class, wait behind what the screen reads.
	echo bfq >/sys/block/mmcblk0/queue/scheduler 2>/dev/null
	eend 0
}

stop() {
	# Keep the clock chip in step with what the system learned (from the robot or the network).
	[ -e /dev/rtc0 ] && hwclock -w -u 2>/dev/null
	return 0
}
