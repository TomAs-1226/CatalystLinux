#!/sbin/openrc-run
# Wi-Fi, when it has been switched on in Settings. Otherwise the radio's
# driver is not even loaded: it is the handheld's largest idle draw after the
# screen. Networks and their passwords are kept in
# /data/wifi/wpa_supplicant.conf.
#
# Three pieces come and go together: the driver, wpa_supplicant (joins
# networks), and an ifplugd that asks for an address once one is joined.

description="Wi-Fi, only when enabled"

depend() {
	need catalyst-early
	after catalyst-late
}

start() {
	if [ ! -e /data/catalyst/wifi-enabled ]; then
		einfo "Wi-Fi is switched off"
		echo off >/run/catalyst-wifi.status
		return 0
	fi
	ebegin "Starting Wi-Fi"
	# How it stands, for the shell to say: starting, running, or why not.
	echo starting >/run/catalyst-wifi.status
	modprobe brcmfmac
	# The radio loads its firmware over SDIO and appears: usually within two
	# seconds, given fifteen (a first start after power-on can be slower).
	n=0
	while [ ! -e /sys/class/net/wlan0 ] && [ $n -lt 150 ]; do
		sleep 0.1
		n=$((n + 1))
	done
	if [ ! -e /sys/class/net/wlan0 ]; then
		echo "the radio did not start" >/run/catalyst-wifi.status
		# What the driver said, kept for looking into it (Files › catalyst).
		mkdir -p /data/catalyst
		dmesg | grep -iE "brcm|mmc1|sdio|cfg80211|firmware" | tail -n 40 >/data/catalyst/wifi-start.log
		eend 1 "the radio did not appear"
		return 1
	fi
	mkdir -p /data/wifi
	if [ ! -e /data/wifi/wpa_supplicant.conf ]; then
		# update_config lets the shell save networks; the control socket is how it asks.
		printf 'ctrl_interface=/run/wpa_supplicant\nupdate_config=1\n' >/data/wifi/wpa_supplicant.conf
	fi
	chmod 600 /data/wifi/wpa_supplicant.conf
	ip link set wlan0 up 2>/dev/null
	wpa_supplicant -B -P /run/wpa_supplicant.pid -i wlan0 -c /data/wifi/wpa_supplicant.conf >/dev/null
	# -M: the kernel says when the link comes and goes (netlink), so joining
	# is heard at once and the poll (-t) is a backstop every 30 s, not 2 s.
	start-stop-daemon -S -b -m -p /run/ifplugd.wlan0.pid -x /usr/sbin/ifplugd -- \
		-n -i wlan0 -M -I -u 0 -d 2 -t 30 -r /usr/sbin/catalyst-net -x dhcp-only
	# The first look round at once, so networks are listed by the time
	# anyone opens the page.
	wpa_cli -p /run/wpa_supplicant -i wlan0 scan >/dev/null 2>&1
	echo running >/run/catalyst-wifi.status
	eend 0
}

stop() {
	ebegin "Stopping Wi-Fi"
	start-stop-daemon -K -q -p /run/ifplugd.wlan0.pid 2>/dev/null
	start-stop-daemon -K -q -p /run/wpa_supplicant.pid 2>/dev/null
	/usr/sbin/catalyst-net wlan0 down
	rm -f /run/ifplugd.wlan0.pid
	ip link set wlan0 down 2>/dev/null
	# Unload the driver, and what it alone was using: the radio goes quiet.
	sleep 0.3
	modprobe -r brcmfmac 2>/dev/null
	echo off >/run/catalyst-wifi.status
	eend 0
}
