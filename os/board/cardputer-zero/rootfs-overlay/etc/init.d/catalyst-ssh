#!/sbin/openrc-run
# SSH is off unless it was switched on from the System screen, which runs
# "catalyst-ssh-toggle on". The choice and the host key live on /data.
# Logins are key-only (-s): public keys go in /data/ssh/authorized_keys.

description="Dropbear SSH, only when enabled"
command=/usr/sbin/dropbear
command_args="-R -r /data/ssh/host_ed25519 -s"
pidfile=/run/dropbear.pid

depend() {
	need localmount
}

start_pre() {
	if [ ! -e /data/catalyst/ssh-enabled ]; then
		einfo "SSH is switched off"
		return 1
	fi
	mkdir -p /data/ssh
	[ -e /data/ssh/host_ed25519 ] || dropbearkey -t ed25519 -f /data/ssh/host_ed25519 >/dev/null
}
