#!/sbin/openrc-run
# Wired Ethernet: DHCP, or a fixed address on the robot network without it.
# ifplugd watches the cable and runs /usr/sbin/catalyst-net when it changes;
# -M waits for the adapter to appear, since it is a USB device. -m iff reads
# the link from the interface's own flags: asking the adapter (ethtool, MII)
# every two seconds would wake it each time from the sleep it takes while
# idle, which is most of what it costs.

description="Catalyst Linux wired network"
supervisor=supervise-daemon
command=/usr/sbin/ifplugd
command_args="-n -i eth0 -M -m iff -I -u 0 -d 1 -t 2 -r /usr/sbin/catalyst-net"
respawn_delay=2

depend() {
	need catalyst-early
	after catalyst-late
}
