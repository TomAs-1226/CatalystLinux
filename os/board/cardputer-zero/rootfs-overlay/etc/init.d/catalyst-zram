#!/sbin/openrc-run
# Swap kept in memory, compressed (zram). Pages nothing has touched for a
# while are squeezed to about a third of their size and stay in RAM, so a
# model answering or a big page in Web has room without the card being
# written: nothing here ever goes to the SD card.
#
# Half the memory by default (256 MB of swap on the 512 MB board, which holds
# perhaps 80-100 MB of real RAM once compressed). lz4: on the A53 it packs
# several times faster than zstd for a little less room, and fast is what
# keeps the screen fluid while it swaps.
#
# /data/catalyst/zram, if present, says otherwise: "off", or a size in MB.

description="Compressed swap in memory"

depend() {
	need catalyst-early
	after catalyst-shell
}

DEV=/dev/zram0
SYS=/sys/block/zram0

start() {
	ebegin "Setting up compressed swap in memory"
	choice=$(cat /data/catalyst/zram 2>/dev/null)
	if [ "$choice" = off ]; then
		eend 0
		return 0
	fi
	if grep -q "^$DEV " /proc/swaps; then
		eend 0
		return 0
	fi
	[ -e "$SYS" ] || modprobe zram num_devices=1 2>/dev/null
	if [ ! -e "$SYS" ]; then
		eend 1 "no zram in this kernel"
		return 1
	fi
	case "$choice" in
	'' | *[!0-9]*) size=$(($(awk '/^MemTotal:/ { print $2 }' /proc/meminfo) / 2))K ;;
	*) size=${choice}M ;;
	esac
	echo 1 >"$SYS/reset" 2>/dev/null
	echo lz4 >"$SYS/comp_algorithm" 2>/dev/null
	echo "$size" >"$SYS/disksize" &&
		mkswap "$DEV" >/dev/null &&
		{ swapon -p 100 "$DEV" 2>/dev/null || swapon "$DEV"; }
	r=$?
	# Swapping to memory is cheap: let the kernel swap idle pages rather than
	# drop the file cache it will read again, and one page at a time (there
	# is no seek to save by reading ahead).
	echo 100 >/proc/sys/vm/swappiness
	echo 0 >/proc/sys/vm/page-cluster
	eend $r
}

stop() {
	swapoff "$DEV" 2>/dev/null
	echo 1 >"$SYS/reset" 2>/dev/null
	return 0
}
