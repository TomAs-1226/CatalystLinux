# Catalyst Linux for the M5Stack CardputerZero (Raspberry Pi CM0, 64-bit).
BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_MUSL_STABLE=y
BR2_TARGET_GENERIC_HOSTNAME="catalyst"
BR2_TARGET_GENERIC_ISSUE="Catalyst Linux"
# Every time zone's rules (/usr/share/zoneinfo), for the zone chosen in setup
# or Settings. No default zone here: /etc/localtime is a link to the choice on
# /data (post-build.sh makes it), and with none chosen the time is UTC.
BR2_TARGET_TZ_INFO=y
BR2_TARGET_TZ_ZONELIST="default"
BR2_TARGET_LOCALTIME=""
BR2_INIT_OPENRC=y
# mdev (part of BusyBox) loads drivers by modalias at boot and on hotplug:
# the I2C and SPI controllers, USB Ethernet, anything plugged into the hub.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
# The root filesystem stays read-only: the power switch cuts power at once.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CATALYST_PATH)/board/cardputer-zero/busybox.fragment"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CATALYST_PATH)/board/cardputer-zero/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CATALYST_PATH)/board/cardputer-zero/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_CATALYST_PATH)/board/cardputer-zero/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
# raspberrypi/linux rpi-6.18.y (6.18.62): the series M5Stack builds its drivers against.
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,ea17ae02ca28483e508b05c7c44190c01a1ef8eb)/linux-ea17ae02ca28483e508b05c7c44190c01a1ef8eb.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CATALYST_PATH)/board/cardputer-zero/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2710-rpi-cm0"
BR2_LINUX_KERNEL_DTB_OVERLAY_SUPPORT=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# The kernel compresses its modules with xz; the module tools on the device
# and the build machine's depmod both have to read them.
BR2_PACKAGE_XZ=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
# The full firmware, as M5Stack ships it: the camera's image processing (the
# ISP libcamera drives) runs in it, which the cut-down firmware leaves out.
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_CATALYST_PATH)/board/cardputer-zero/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_CATALYST_PATH)/board/cardputer-zero/cmdline.txt"
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WIRELESS_REGDB=y
# In the image but not started: SSH is switched on from the System screen.
# Its client too (dbclient, and dropbearkey for a key of the handheld's own),
# for the SSH app to reach other machines.
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
# Tools for a pocket developer machine, run from the Terminal. Nothing of
# them runs until called. BusyBox keeps its own small versions of what these
# do not replace; these take over where they do (vi stays BusyBox's, vim is
# vim).
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PYC_ONLY=y
# Python's own modules a script commonly reaches for: compressed files,
# HTTPS (urllib through OpenSSL; curl and git stay on mbedTLS), line editing
# at its prompt, curses, SQLite and XML.
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_READLINE=y
BR2_PACKAGE_PYTHON3_CURSES=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_VIM=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_TMUX=y
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_JQ=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_PICOCOM=y
# Text web browsers for the Terminal and the Web app: a few MB, no
# JavaScript, keyboard first; HTTPS through the OpenSSL Python already uses.
BR2_PACKAGE_LYNX=y
BR2_PACKAGE_LINKS=y
# The on-device model's runtime: llama.cpp's llama-server, started only when
# the assistant or `ai --local` asks, on a model downloaded to /data/models.
# Its CPU flags are pinned to the A53's (package/llama-cpp-catalyst); every
# other llama tool is taken out of the image in post-build.sh.
BR2_PACKAGE_LLAMA_CPP=y
BR2_PACKAGE_LLAMA_CPP_TOOLS=y
# The Terminal says it is an xterm, which ncurses describes; tmux's own
# descriptions too, for what runs inside it.
BR2_PACKAGE_NCURSES_ADDITIONAL_TERMINFO="t/tmux t/tmux-256color"
# The camera (an IMX219 on the CSI port), for the AprilTag reader:
# libcamera with the Raspberry Pi pipeline, and catalyst-camera, a small
# program of our own that streams its picture to the reader only while it is
# open. (rpicam-apps needs kernel headers newer than this toolchain's 5.4.)
BR2_PACKAGE_LIBCAMERA=y
BR2_PACKAGE_LIBCAMERA_PIPELINE_RPI_VC4=y
BR2_PACKAGE_CATALYST_CAMERA=y
# Photos as JPEG: libjpeg-turbo, its NEON code (plain NEON: nothing this
# processor lacks).
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_JPEG_TURBO=y
# resize2fs, to grow /data over the whole card on first boot.
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
# HTTPS for updates, the event schedule, Weather, the assistant, the app
# catalogue and git: curl on OpenSSL, which Python's ssl brings anyway, with
# the certificates to check the servers by. (Not mbedTLS: Buildroot gives
# curl a certificate list only with OpenSSL or wolfSSL, so on mbedTLS it
# trusted nothing and every HTTPS request failed, 0.4.1 and before.) Nothing
# of it runs until something asks for a download.
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
# Git on the handheld: a repository's status, log and diffs, and pulling.
BR2_PACKAGE_GIT=y
# Tailscale, to reach the machines on your tailnet from anywhere:
# our own slim build (one binary, the CLI inside), not Buildroot's package,
# which would switch on nftables, NAT and conntrack in the kernel. Runs only
# when switched on in Settings › Network › Tailscale (the kernel's TUN is a
# module already). The Go toolchain is built for it on the build machine.
BR2_PACKAGE_CATALYST_TAILSCALE=y
# The GPU: Mesa's vc4 driver for the VideoCore IV (OpenGL ES 2.0 through
# EGL), which the shell uses for glass, wallpapers and compositing when it
# works, falling back to the processor when it does not. softpipe is Mesa's
# software renderer: the same GL path on the processor, which is how the
# GPU path is tested where there is no VideoCore (the emulator).
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_M5STACK_CARDPUTER_ZERO=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# Each system slot is 1 GB: room for more tools and apps than the first
# images (about 100 MB) need. The root is read-only, so no blocks are held
# back for root the way a writable filesystem keeps them.
BR2_TARGET_ROOTFS_EXT2_SIZE="1024M"
BR2_TARGET_ROOTFS_EXT2_RESBLKS=0
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
