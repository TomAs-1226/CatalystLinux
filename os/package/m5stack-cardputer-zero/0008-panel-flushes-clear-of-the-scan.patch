+/*
+ * Catalyst Linux: a flush timed from the panel's scan (patch 0008). As
+ * mipi_dbi_pipe_update would, but with the pixels' bytes swapped into the
+ * transmit buffer and the window set before the wait, so that the band's
+ * first pixel goes out right as the wait ends (the swap of a whole frame
+ * is most of a millisecond: 20 rows of the scan).
+ */
+static void panel_mipi_dbi_timed_update(struct panel_mipi_dbi_device *panel,
+                                        struct drm_plane_state *state,
+                                        struct drm_rect *band)
+{
+    struct mipi_dbi_dev *dbidev = &panel->dbidev;
+    struct mipi_dbi *dbi = &dbidev->dbi;
+    struct drm_shadow_plane_state *shadow = to_drm_shadow_plane_state(state);
+    struct drm_framebuffer *fb = state->fb;
+    const struct drm_format_info *format = fb->format;
+    unsigned int xs = band->x1 + dbidev->left_offset, xe = band->x2 - 1 + dbidev->left_offset;
+    unsigned int ys = band->y1 + dbidev->top_offset, ye = band->y2 - 1 + dbidev->top_offset;
+    ktime_t start;
+    size_t len;
+    int idx, ret;
+
+    if (!drm_dev_enter(fb->dev, &idx))
+        return;
+
+    ret = mipi_dbi_buf_copy(dbidev->tx_buf, &shadow->data[0], fb, band,
+                            dbi->swap_bytes, &shadow->fmtcnv_state);
+    if (ret)
+        goto out;
+    mipi_dbi_command(dbi, MIPI_DCS_SET_COLUMN_ADDRESS, (xs >> 8) & 0xff, xs & 0xff,
+                     (xe >> 8) & 0xff, xe & 0xff);
+    mipi_dbi_command(dbi, MIPI_DCS_SET_PAGE_ADDRESS, (ys >> 8) & 0xff, ys & 0xff,
+                     (ye >> 8) & 0xff, ye & 0xff);
+
+    panel_mipi_dbi_wait_for_te(panel, band, fb->height);
+
+    if (format->format == DRM_FORMAT_XRGB8888)
+        format = drm_format_info(dbidev->pixel_format);
+    len = drm_format_info_min_pitch(format, 0, drm_rect_width(band)) * drm_rect_height(band);
+    start = ktime_get();
+    ret = mipi_dbi_command_buf(dbi, MIPI_DCS_WRITE_MEMORY_START, (u8 *)dbidev->tx_buf, len);
+    if (!ret)
+        panel_mipi_dbi_note_write(panel, band, ktime_sub(ktime_get(), start));
+out:
+    if (ret)
+        drm_err_once(fb->dev, "Failed to update display %d\n", ret);
+    drm_dev_exit(idx);
+}
+
 /* Update callback remains locked to serialize normal transfers with reset. */
 static void panel_mipi_dbi_pipe_update(struct drm_simple_display_pipe *pipe,
                        struct drm_plane_state *old_state)
@@ -633,20 +744,15 @@
     struct panel_mipi_dbi_device *panel = to_panel_mipi_dbi_device(dbidev);
