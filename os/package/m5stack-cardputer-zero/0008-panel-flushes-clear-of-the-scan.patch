+/* x as a time within one period: 0 <= result < period. */
+static s64 panel_mipi_dbi_in_period(s64 x, s64 period)
+{
+    s32 rem;
+
+    div_s64_rem(x, (s32)period, &rem);
+    return rem < 0 ? rem + period : rem;
+}
