 /*
- * TE support is intentionally disabled for now. Keep these definitions here
- * so TE can be enabled again when the panel wiring and timing are verified.
+ * Catalyst Linux: the tearing-effect line, used where the Device Tree gives
+ * `te-gpios` (and not otherwise, so the driver is as it was without it).
+ * Only Catalyst Linux's portrait overlay gives it, with an init sequence
+ * that has the panel take rows in the order it scans them (MADCTL 0x00).
+ *
+ * SET_TEAR_ON's parameter 0: the line rises as the scan leaves the last row
+ * and stays high through the vertical blank (the porches), after which the
+ * scan starts again at row 0. Its rising edges give the scan's phase, and the
+ * time between them its speed. The interrupt is on while the panel is, and
+ * each edge only notes the time.
+ *
+ * A band of rows written in the scan's direction cannot tear unless the scan
+ * crosses it while it is being written. So each flush is started where it
+ * will not be crossed:
+ *
+ * - Writing slower than the scan (this panel: SPI at about 42 to 50 MHz is
+ *   54 to 65 us a row, the scan 49 us a row at 60 Hz), the band follows the
+ *   scan: it starts just after the scan has passed its first row. This
+ *   refresh shows the old rows, the next the new ones whole, provided the
+ *   band is done before the scan comes round again behind it: (rows x the
+ *   difference in row time) under a period, at most 5 ms of 16.7 here, so
+ *   most of the time a flush can go at once.
+ * - Writing faster than the scan, it leads: it starts while the scan is above
+ *   the band, or once the scan has gone past it.
+ *
+ * How long a row takes to write is measured on the flushes themselves.
+ *
+ * (Before, each flush enabled the interrupt, waited for an edge, and
+ * disabled it again. The BCM2835's GPIO interrupts have no disable of their
+ * own, so the kernel disabled them lazily: an edge while "disabled" was kept
+ * pending and replayed as soon as the interrupt was enabled. The wait
+ * returned at once, at any point in the scan, and frames still tore.)
  */
-#if 0
-#ifndef MIPI_DCS_SET_TEAR_ON
-#define MIPI_DCS_SET_TEAR_ON		0x35
-#endif
-#define MIPI_DCS_TEAR_MODE_VBLANK	0x00
-#endif
+#define CATALYST_TEAR_MODE_VBLANK	0x00
+/* Rows the panel scans in each refresh besides the picture's: PORCTRL's 5 + 5. */
+#define CATALYST_PORCH_ROWS		10
+/* Rows kept between a band and the scan: the interrupt's and the commands' lateness. */
+#define CATALYST_MARGIN_ROWS		6
+/* How long a flush waits for an edge to time itself from before going anyway. */
+#define CATALYST_TE_WAIT_MS		50
+/* Flushes in a row that saw no edge before the line is taken to be silent. */
+#define CATALYST_TE_GIVE_UP		3
+/* Bands smaller than this are mostly the commands' own time: not measured. */
+#define CATALYST_MEASURE_PIXELS		4096
 
 
 struct panel_mipi_dbi_format {
@@ -57,11 +99,21 @@
     struct mipi_dbi_dev dbidev;
 
     /*
-     * TE support is intentionally disabled for now and may be enabled later.
-     * struct gpio_desc *te;
-     * int te_irq;
-     * struct completion te_completion;
+     * Catalyst Linux: the panel's tearing-effect line, when the Device Tree
+     * gives one (see above).
      */
+    struct gpio_desc *te;
+    int te_irq;
+    bool te_on;			/* its interrupt is on (the panel is on) */
+    bool te_silent;		/* no edges came: flushes no longer wait */
+    unsigned int te_missed;	/* flushes in a row that saw no edge */
+    wait_queue_head_t te_wait;
+    spinlock_t te_lock;		/* the three below, written by the interrupt */
+    u64 te_edges;		/* rising edges seen since the interrupt went on */
+    ktime_t te_last;		/* the latest */
+    s64 te_period_ns;		/* time between two, smoothed; 0 until known */
+    u64 write_ps;		/* time a flush takes a pixel, smoothed; 0 until known */
+    unsigned int te_followed, te_led, te_unsynced;	/* flushes, by how they went */
     struct mutex display_lock;		/* Serialize reset and display transfers */
 };
 
@@ -277,12 +329,10 @@
 
     panel_mipi_dbi_commands_execute(dbi, dbidev->driver_private);
 
-    /* TE support is intentionally disabled; re-enable this with TE support. */
-    /*
+    /* Catalyst Linux: the tearing-effect line on, where there is one. */
     if (panel->te)
         mipi_dbi_command(dbi, MIPI_DCS_SET_TEAR_ON,
-                 MIPI_DCS_TEAR_MODE_VBLANK);
-    */
+                 CATALYST_TEAR_MODE_VBLANK);
 
     if (dbidev->regulator)
         regulator_disable(dbidev->regulator);
@@ -328,8 +378,50 @@
 
 static DEVICE_ATTR(reset, 0200, NULL, panel_mipi_dbi_reset_store);
 
+/*
+ * Catalyst Linux: how the tearing-effect line is doing, for the shell
+ * (Settings > Developer options > Tear-free panel):
+ * "state=none|off|starting|in-step|silent period_ns=... write_ps=...
+ * followed=... led=... unsynced=...".
+ */
+static ssize_t tearing_effect_show(struct device *dev,
+                   struct device_attribute *attr, char *buf)
+{
+    struct drm_device *drm = spi_get_drvdata(to_spi_device(dev));
+    struct panel_mipi_dbi_device *panel;
+    const char *state;
+    unsigned long flags;
+    s64 period;
+
+    if (!drm)
+        return -ENODEV;
+    panel = to_panel_mipi_dbi_device(drm_to_mipi_dbi_dev(drm));
+    if (!panel->te)
+        return sysfs_emit(buf, "state=none\n");
+
+    spin_lock_irqsave(&panel->te_lock, flags);
+    period = panel->te_period_ns;
+    spin_unlock_irqrestore(&panel->te_lock, flags);
+
+    if (panel->te_silent)
+        state = "silent";
+    else if (!panel->te_on)
+        state = "off";
+    else if (!period)
+        state = "starting";
+    else
+        state = "in-step";
+
+    return sysfs_emit(buf, "state=%s period_ns=%lld write_ps=%llu followed=%u led=%u unsynced=%u\n",
+              state, period, panel->write_ps, panel->te_followed,
+              panel->te_led, panel->te_unsynced);
+}
+
+static DEVICE_ATTR_RO(tearing_effect);
+
 static struct attribute *panel_mipi_dbi_attrs[] = {
     &dev_attr_reset.attr,
+    &dev_attr_tearing_effect.attr,
     NULL,
 };
 
@@ -337,40 +429,147 @@
     .attrs = panel_mipi_dbi_attrs,
 };
 
-/*
- * TE support is intentionally disabled for now. Keep the handler and wait
- * logic here for possible later re-enablement when TE timing is verified.
- */
-#if 0
-/* TE interrupt handler: wake waiters when a TE signal arrives */
+/* Catalyst Linux: a rising edge of the tearing-effect line. Its time is noted. */
 static irqreturn_t panel_mipi_dbi_te_isr(int irq, void *data)
 {
     struct panel_mipi_dbi_device *panel = data;
+    ktime_t now = ktime_get();
+    unsigned long flags;
 
-    complete(&panel->te_completion);
+    spin_lock_irqsave(&panel->te_lock, flags);
+    if (panel->te_edges) {
+        s64 period = ktime_to_ns(ktime_sub(now, panel->te_last));
+
+        /* 25 to 100 refreshes a second; anything else is an edge missed. */
+        if (period >= 10 * NSEC_PER_MSEC && period <= 40 * NSEC_PER_MSEC)
+            panel->te_period_ns = panel->te_period_ns ?
+                (panel->te_period_ns * 7 + period) / 8 : period;
+    }
+    panel->te_last = now;
+    panel->te_edges++;
+    spin_unlock_irqrestore(&panel->te_lock, flags);
+
+    wake_up_all(&panel->te_wait);
 
     return IRQ_HANDLED;
 }
 
-/* Wait for the panel TE sync signal before flushing */
-static void panel_mipi_dbi_wait_for_te(struct panel_mipi_dbi_device *panel)
+/*
+ * The interrupt on while the panel is on, off while it sleeps. Off is off at
+ * once (IRQ_DISABLE_UNLAZY, set at probe), so no stale edge is kept.
+ */
+static void panel_mipi_dbi_te_switch(struct panel_mipi_dbi_device *panel, bool on)
 {
-    if (!panel->te)
+    unsigned long flags;
+
+    if (!panel->te || panel->te_on == on)
+        return;
+
+    if (on) {
+        spin_lock_irqsave(&panel->te_lock, flags);
+        panel->te_edges = 0;	/* the period is kept: it is the panel's */
+        spin_unlock_irqrestore(&panel->te_lock, flags);
+        /* Woken again: a line silent before is given another chance. */
+        panel->te_silent = false;
+        panel->te_missed = 0;
+        enable_irq(panel->te_irq);
+    } else {
+        disable_irq(panel->te_irq);
+    }
+    panel->te_on = on;
+}
+
+/*
+ * Wait until rows y0..y1 (as wide as `width`) of a picture `rows` tall can
+ * be written without the scan crossing them (see the top of the file).
+ */
+static void panel_mipi_dbi_wait_for_te(struct panel_mipi_dbi_device *panel,
+                       const struct drm_rect *band, unsigned int rows)
+{
+    s64 y0 = band->y1, y1 = band->y2, period, scan, write, phase, wait = 0;
+    unsigned long flags;
+    ktime_t last, now;
+    u64 edges;
+    s32 rem;
+    int tries;
+
+    if (!panel->te || !panel->te_on || panel->te_silent)
         return;
 
-    reinit_completion(&panel->te_completion);
+    /* A recent edge to time from, and the time between two. */
+    for (tries = 0; ; tries++) {
+        spin_lock_irqsave(&panel->te_lock, flags);
+        edges = panel->te_edges;
+        last = panel->te_last;
+        period = panel->te_period_ns;
+        spin_unlock_irqrestore(&panel->te_lock, flags);
+        now = ktime_get();
+        if (edges && period && ktime_to_ns(ktime_sub(now, last)) < 2 * period)
+            break;
+        if (tries == 2) {
+            panel->te_unsynced++;
+            return;
+        }
+        if (!wait_event_timeout(panel->te_wait, READ_ONCE(panel->te_edges) != edges,
+                    msecs_to_jiffies(CATALYST_TE_WAIT_MS))) {
+            panel->te_unsynced++;
+            if (++panel->te_missed >= CATALYST_TE_GIVE_UP) {
+                panel->te_silent = true;
+                dev_warn(panel->dbidev.drm.dev,
+                     "no tearing-effect signal: flushes go out without waiting for it\n");
+            }
+            return;
+        }
+        panel->te_missed = 0;
+    }
+
+    scan = div_s64(period, rows + CATALYST_PORCH_ROWS);
+    write = div_u64((u64)drm_rect_width(band) * panel->write_ps, 1000);
+    div_s64_rem(ktime_to_ns(ktime_sub(now, last)), (s32)period, &rem);
+    phase = rem;	/* since the latest edge, in this refresh */
+
+    if (!write || write >= scan) {
+        /* Follow: start once the scan has passed the first row... */
+        s64 start = (CATALYST_PORCH_ROWS + y0 + CATALYST_MARGIN_ROWS) * scan;
+        /* ...and soon enough to be done before it comes round again. */
+        s64 slack = period - (y1 - y0) * (write > scan ? write - scan : 0)
+            - 2 * CATALYST_MARGIN_ROWS * scan;
+        s64 late = phase - start;
 
-    /* Enable the IRQ only while waiting; keep it disabled otherwise to save power */
-    enable_irq(panel->te_irq);
+        if (late < 0)
+            late += period;
+        if (late > max_t(s64, slack, 0))
+            wait = period - late;
+        panel->te_followed++;
+    } else {
+        /* Lead: start while the scan is above the band, or once it is past. */
+        s64 above = (CATALYST_PORCH_ROWS + y0 - CATALYST_MARGIN_ROWS) * scan;
+        s64 past = (CATALYST_PORCH_ROWS + y1 + CATALYST_MARGIN_ROWS) * scan;
 
-    if (!wait_for_completion_timeout(&panel->te_completion,
-                     msecs_to_jiffies(100)))
-        dev_warn_once(panel->dbidev.drm.dev,
-                  "Timeout waiting for TE signal\n");
+        if (phase >= above && phase <= past)
+            wait = min(past, period) - phase;
+        panel->te_led++;
+    }
+
+    if (wait > 0) {
+        u64 us = div_u64(wait, NSEC_PER_USEC);
 
-    disable_irq(panel->te_irq);
+        usleep_range(us, us + 50);
+    }
+}
+
+/* Catalyst Linux: how long a flush took a pixel, for timing the next. */
+static void panel_mipi_dbi_note_write(struct panel_mipi_dbi_device *panel,
+                      const struct drm_rect *band, ktime_t took)
+{
+    u64 pixels = (u64)drm_rect_width(band) * drm_rect_height(band);
+    u64 ps;
+
+    if (pixels < CATALYST_MEASURE_PIXELS)
+        return;
+    ps = div64_u64((u64)ktime_to_ns(took) * 1000, pixels);
+    panel->write_ps = panel->write_ps ? (panel->write_ps * 3 + ps) / 4 : ps;
 }
-#endif
 
